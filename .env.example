# Secret used to sign the account session cookie. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# Neon Postgres for configurator orders. On Vercel the Neon integration sets
# this; locally use `vercel env pull .env.local` or a Neon branch's pooled URL.
DATABASE_URL=

# Local development only: the prod database's URL (DATABASE_URL in
# .env.production.local). When set, `npm run dev` shows a Dev DB / Prod DB
# switch in the portal. Prod gets full read/write, so mind what you click.
# Sessions and rate limits always stay in DATABASE_URL.
DATABASE_URL_PROD=

# Resend, for order emails. On Vercel the Resend integration sets this; locally
# `vercel env pull .env.local`. Without it orders still save and emails are skipped.
RESEND_API_KEY=

# Sender on a domain verified in Resend. Defaults to orders@ the integration's
# RESEND_EMAIL_DOMAIN, else Resend's test sender, which only reaches the account owner.
EMAIL_FROM="ZODE <orders@zode.org>"

# Inbox that gets a copy of every order. Defaults to hello@zode.org.
ORDERS_NOTIFY_EMAIL=

# Optional, ignored on the production deployment: send every email here instead,
# with the real recipient in the subject. Use it when placing test orders.
EMAIL_DEV_TO=

# Private Vercel Blob store for data room files. Create a store with private
# access under Storage in the Vercel project; connecting it sets this. Locally
# `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=

# ZOS user ids (comma separated) allowed to create data rooms. Anyone can
# register a ZOS account, so unset means nobody outside local development. Ids
# appear in the "New ZODE account" team email.
DATA_ROOM_CREATORS=

# Inbox that gets a copy of every executed MNDA. Defaults to ORDERS_NOTIFY_EMAIL,
# then hello@zode.org.
MNDA_NOTIFY_EMAIL=

# ZOS account API for /register, /login and /portal. Defaults to production ZOS.
ZOS_API_URL=https://zosapi.zero.tech

# Invite slug used when someone registers without one.
ZOS_DEFAULT_INVITE_CODE=
