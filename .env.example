# Shared password required to view the site.
SITE_PASSWORD=changeme

# Secret used to sign the session cookie. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# Neon Postgres for configurator orders. On Vercel the Neon integration sets
# this; locally use `vercel env pull .env.local` or a Neon branch's pooled URL.
DATABASE_URL=

# Resend, for order emails. On Vercel the Resend integration sets this; locally
# `vercel env pull .env.local`. Without it orders still save and emails are skipped.
RESEND_API_KEY=

# Sender on a domain verified in Resend. Defaults to ZODE <orders@zode.org> in
# production and Resend's test sender (which only reaches the account owner) in dev.
EMAIL_FROM="ZODE <orders@zode.org>"

# Inbox that gets a copy of every order. Defaults to hello@zode.org.
ORDERS_NOTIFY_EMAIL=

# Optional, ignored on the production deployment: send every email here instead,
# with the real recipient in the subject. Use it when placing test orders.
EMAIL_DEV_TO=

# ZOS account API for /register, /login and /portal. Defaults to production ZOS.
ZOS_API_URL=https://zosapi.zero.tech

# Invite slug used when someone registers without one.
ZOS_DEFAULT_INVITE_CODE=
