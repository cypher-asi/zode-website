{
  "name": "the-grid-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "zrm:import": "node --env-file-if-exists=.env.local scripts/import-oden.mjs",
    "prebuild": "npm run db:migrate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && npm run lint:colors && npm run lint:brand",
    "lint:colors": "node scripts/check-colors.mjs",
    "lint:brand": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-brand-tokens.mjs",
    "check:model": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-compute-model.mjs",
    "brand:kit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/make-brand-kit.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@vercel/blob": "^2.8.1",
    "client-zip": "^2.5.1",
    "d3-geo": "^3.1.1",
    "docx-preview": "^0.4.1",
    "next": "^16.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pptx-preview": "^1.0.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^9.3.12",
    "remark-gfm": "^4.0.1",
    "resend": "^6.32.1",
    "three": "^0.184.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.18",
      "sharp": "^0.35.5"
    },
    "pptx-preview": {
      "echarts": "^6.1.0",
      "uuid": "^11.1.1"
    }
  }
}
